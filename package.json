{
  "name": "local-agent-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "sh ./scripts/dev.sh",
    "dev:web": "next dev --hostname 0.0.0.0",
    "dev:api": "sh ./scripts/python.sh -m uvicorn python_backend.main:app --host 0.0.0.0 --port 8001",
    "setup:python": "sh ./scripts/setup-python.sh",
    "typecheck": "tsc -b --noEmit",
    "test:python": "sh ./scripts/python.sh -m pytest -q",
    "build": "next build"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "framer-motion": "^11.18.2",
    "isomorphic-git": "^1.41.9",
    "neofetch": "^7.1.0",
    "next": "15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "fallow": "^3.19.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  },
  "packageManager": "bun@1.1.38"
}
