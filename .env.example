# Local Agent Studio - Environment Variables
# Copy this file to .env and configure as needed

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=90

# Backend Configuration
BACKEND_URL=http://127.0.0.1:8001

# Agent Configuration
APPROVAL_TIMEOUT_SECONDS=300
MAX_CONTEXT_CHARS=18000
MAX_TOOL_ROUNDS=3
FALLBACK_MODEL=qwen2.5:3b
GENERATION_STALL_TIMEOUT_SECONDS=45
PROVIDER_PROBE_TIMEOUT_SECONDS=5

# GitHub Integration (Optional)
# IMPORTANT: Both variables are required for GitHub integration to work
# GITHUB_TOKEN: Your GitHub personal access token or fine-grained token
# GITHUB_ALLOWED_REPOSITORIES: Comma-separated list of authorized repositories (owner/repo format)
# Example: GITHUB_ALLOWED_REPOSITORIES=myorg/repo1,myorg/repo2
#
# Security: The allowlist prevents unauthorized access to repositories via the server's token.
# If GITHUB_ALLOWED_REPOSITORIES is empty or unset, all GitHub operations will be rejected.
#
# GITHUB_TOKEN=ghp_your_token_here
# GITHUB_ALLOWED_REPOSITORIES=myorg/repo1,myorg/repo2

# Filesystem Agent Configuration
SCRIPT_TIMEOUT_SECONDS=8

# Database
AGENT_STATE_DB=.local_agent_studio/state.db
